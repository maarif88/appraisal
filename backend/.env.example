# DataForSEO integration removed: provider credentials are not accepted.
# ─────────────────────────────────────────────────
# YPYM Appraisal - Backend Environment Variables
# ─────────────────────────────────────────────────

# Server
PORT=3100
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (SQLite - file path relative to backend/)
DATABASE_PATH=./data/ypym-appraisal.db

# Optional credentials for separate data collection; public HTTP analysis uses the stored catalog.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=


# Exchange Rate (optional - open.er-api.com is free without key)
FX_RATE_API_KEY=

# Defaults
DEFAULT_CURRENCY_BASE=USD
DEFAULT_LOCALE_COUNTRY=ID
DEFAULT_LOCALE_LANGUAGE=id

# Pipeline limits
MAX_KEYWORDS_PER_RUN=500
AUTOCOMPLETE_DELAY_MIN_MS=300
AUTOCOMPLETE_DELAY_MAX_MS=800

# Public access: no login credentials. All limits use UTC days and persist in SQLite.
ANALYSIS_MAX_PER_DAY=10
ANALYSIS_MAX_PER_CLIENT_DAY=3
PROJECTS_MAX_PER_DAY=200
PROJECTS_MAX_PER_CLIENT_DAY=10
PROJECTS_MAX_STORED=5000
# Trust only the reverse proxy network; restrict the origin port to Coolify/proxy access.
TRUST_PROXY=loopback,linklocal,uniquelocal
